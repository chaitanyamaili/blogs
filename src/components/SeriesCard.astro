---
import type { CollectionEntry } from 'astro:content';

interface Props {
  seriesName: string;
  posts: CollectionEntry<'blog'>[];
}

const { seriesName, posts } = Astro.props;
const base = import.meta.env.BASE_URL;

const totalParts = posts.length;
const totalReadingTime = posts.reduce((sum, p) => sum + (p.data.readingTime ?? 0), 0);
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].slice(0, 4);
const seriesSlug = seriesName.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
---

<a
  href={`${base}/series/${seriesSlug}`}
  class="group block rounded-lg border border-border bg-card shadow-md hover:shadow-lg transition-shadow duration-300 overflow-hidden"
>
  <div class="px-6 py-5 flex items-start justify-between gap-4">
    <div class="flex-1 min-w-0 space-y-3">
      <!-- Series badge -->
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full bg-primary/10 text-primary border border-primary/20">
          <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/>
          </svg>
          Series
        </span>
      </div>

      <!-- Title -->
      <h2 class="text-xl font-bold text-foreground group-hover:underline underline-offset-4 decoration-muted-foreground leading-snug">
        {seriesName}
      </h2>

      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-3 text-sm text-muted-foreground">
        <span>{totalParts} parts</span>
        <span aria-hidden="true">·</span>
        <span>~{totalReadingTime} min total</span>
      </div>

      <!-- Tags -->
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.map((tag: string) => (
            <span class="text-xs px-2.5 py-1 rounded-full bg-muted text-muted-foreground border border-border">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>

    <!-- Arrow -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="flex-shrink-0 mt-1 text-muted-foreground group-hover:text-foreground group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
    >
      <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
    </svg>
  </div>
</a>
