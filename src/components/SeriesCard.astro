---
import type { CollectionEntry } from 'astro:content';

interface Props {
  seriesName: string;
  posts: CollectionEntry<'blog'>[];
}

const { seriesName, posts } = Astro.props;
const base = import.meta.env.BASE_URL;

const sortedPosts = [...posts].sort(
  (a, b) => (a.data.seriesPart ?? 0) - (b.data.seriesPart ?? 0)
);

const totalParts = sortedPosts.length;
const tags = [...new Set(sortedPosts.flatMap((p) => p.data.tags))].slice(0, 4);
---

<div class="rounded-lg border border-border bg-card shadow-md overflow-hidden">
  <!-- Series header -->
  <div class="px-6 pt-5 pb-4 border-b border-border">
    <div class="flex items-center gap-2 mb-2">
      <span class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full bg-primary/10 text-primary border border-primary/20">
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/>
        </svg>
        Series
      </span>
      <span class="text-xs text-muted-foreground">{totalParts} parts</span>
    </div>

    <h2 class="text-xl font-bold text-foreground leading-snug">{seriesName}</h2>
  </div>

  <!-- Post list -->
  <ol class="divide-y divide-border">
    {sortedPosts.map((post) => (
      <li>
        <a
          href={`${base}/blog/${post.slug}`}
          class="group flex items-start gap-4 px-6 py-4 hover:bg-muted/50 transition-colors duration-150"
        >
          <span class="flex-shrink-0 mt-0.5 w-7 h-7 rounded-full bg-muted border border-border flex items-center justify-center text-xs font-semibold text-muted-foreground group-hover:border-primary/40 group-hover:text-primary transition-colors">
            {post.data.seriesPart}
          </span>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-foreground group-hover:underline underline-offset-4 decoration-muted-foreground leading-snug">
              {post.data.title}
            </p>
            <p class="text-xs text-muted-foreground mt-0.5 line-clamp-1">
              {post.data.description}
            </p>
          </div>
          <div class="flex-shrink-0 flex items-center gap-1.5 mt-0.5 text-xs text-muted-foreground">
            {post.data.readingTime && (
              <span>{post.data.readingTime} min</span>
            )}
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </div>
        </a>
      </li>
    ))}
  </ol>

  <!-- Footer tags -->
  {tags.length > 0 && (
    <div class="px-6 py-3 border-t border-border flex flex-wrap gap-1.5">
      {tags.map((tag: string) => (
        <span class="text-xs px-2.5 py-1 rounded-full bg-muted text-muted-foreground border border-border">
          {tag}
        </span>
      ))}
    </div>
  )}
</div>
