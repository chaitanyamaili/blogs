---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Chaitanya Maili — Writing">
  <div class="space-y-10">
    <div>
      <h1 class="text-2xl font-bold tracking-tight mb-2">Writing</h1>
      <p class="text-muted-foreground">
        Thoughts on cloud-native engineering, platform infrastructure, and what it takes to grow as an engineer.
      </p>
    </div>

    {posts.length === 0 ? (
      <p class="text-muted-foreground text-sm">No posts yet. Check back soon.</p>
    ) : (
      <div class="space-y-4">
        {posts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
